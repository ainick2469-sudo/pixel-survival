MaterialDef Terrain Array Lighting {

    MaterialParameters {
        TextureArray DiffuseMapArray
        Color SeamMaskColor
        Float SeamMaskStrength
    }

    Technique {
        LightMode SinglePass

        VertexShader   GLSL310 GLSL300 GLSL150 : Shaders/TerrainArrayLighting.vert
        FragmentShader GLSL310 GLSL300 GLSL150 : Shaders/TerrainArrayLighting.frag

        WorldParameters {
            WorldViewProjectionMatrix
            NormalMatrix
            WorldViewMatrix
            ViewMatrix
        }
    }
}
